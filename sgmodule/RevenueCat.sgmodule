#!name = RevenueCat 解锁
#!desc = RevenueCat 系列解锁合集 (请在脚本中选择启用一个作者的脚本)
#!system = ios
#!author=LinkPass888
#!category=Crack

[Argument]
RevenueCat_chxm1023 = false
RevenueCat_Guding88 = false
RevenueCat_ddgksf2013 = false
RevenueCat_Yu9191 = false
 
[MITM]
hostname = api.revenuecat.com, api.rc-backup.com, api.lianjiu.fun
 
[URL Rewrite]
^https:\/\/api\.lianjiu\.fun\/app\/api\/v1\/profile _ reject
 
[Script]
http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js, requires-body=false, tag=[RevenueCat] 会员解锁请求@chxm1023, enable=%{RevenueCat_chxm1023}
http-response ^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js, requires-body=true, tag=[RevenueCat] 会员解锁响应@chxm1023, enable=%{RevenueCat_chxm1023}
http-request ^https?:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/[^\/]+$|receipts$) script-path=https://raw.githubusercontent.com/Guding88/Script/main/APPheji_Revenuecat.js, requires-body=false, tag=[RevenueCat] 会员解锁请求@Guding88, enable=%{RevenueCat_Guding88}
http-response ^https?:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/[^\/]+$|receipts$) script-path=https://raw.githubusercontent.com/Guding88/Script/main/APPheji_Revenuecat.js, requires-body=true, tag=[RevenueCat] 会员解锁响应@Guding88, enable=%{RevenueCat_Guding88}
http-request ^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/deleteHeader.js, requires-body=false, tag=[RevenueCat] 会员解锁请求@ddgksf2013, enable=%{RevenueCat_ddgksf2013}
http-response ^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) script-path=https://ddgksf2013.top/scripts/revenuecat.vip.js, requires-body=true, tag=[RevenueCat] 会员解锁响应@ddgksf2013, enable=%{RevenueCat_ddgksf2013}
http-request ^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+\/(receipts$|subscribers\/[^/]+$) script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Revenuecat.js, requires-body=false, tag=[RevenueCat] 会员解锁请求@Yu9191, enable=%{RevenueCat_Yu9191}
http-response ^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+\/(receipts$|subscribers\/[^/]+$) script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Revenuecat.js, requires-body=true, tag=[RevenueCat] 会员解锁响应@Yu9191, enable=%{RevenueCat_Yu9191}