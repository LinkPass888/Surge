#!name = RevenueCat 解锁
#!desc = RevenueCat 系列解锁合集 (请在脚本中选择启用一个作者的脚本)
#!system = ios
#!author=LinkPass888
#!category=Crack

[Argument]
# 在 Surge 模块设置中，修改下方的值为 on 或 off
chxm1023 = on
Guding88 = on
ddgksf2013 = on
Yu9191 = on

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api.lianjiu.fun

[Script]
# 使用 Surge 的 argument 参数传递功能
# 脚本会接收到这个参数，并根据脚本内的逻辑（if argument == 'off'）执行 $done({})

# chxm1023
RevenueCat-chxm1023 = type=http-response,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/Reheji.js,argument={{chxm1023}}

# Guding88
RevenueCat-Guding88 = type=http-response,pattern=^https?:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(subscribers\/[^\/]+$|receipts$),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/Guding88/Script/main/APPheji_Revenuecat.js,argument={{Guding88}}

# ddgksf2013
RevenueCat-ddgksf2013 = type=http-response,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/?(.*?)*$),requires-body=true,max-size=0,script-path=https://ddgksf2013.top/scripts/revenuecat.vip.js,argument={{ddgksf2013}}

# Yu9191
RevenueCat-Yu9191 = type=http-response,pattern=^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/main/Revenuecat.js,argument={{Yu9191}}

[URL Rewrite]
^https:\/\/api\.lianjiu\.fun\/app\/api\/v1\/profile - reject