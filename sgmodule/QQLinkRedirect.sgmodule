#!category=应用增强

[Script]
QQ链接直开 = type=http-request,pattern=^https?:\/\/c\.pc\.qq\.com\/(?:https?%3A%2F%2F|middlem\.html\?|middlect\.html\?|index\.html\?|ios\.html\?),script-path=https://raw.githubusercontent.com/LinkPass888/Surge/refs/heads/main/js/qq-link-redirect.js,timeout=5

[MITM]
hostname = %APPEND% c.pc.qq.com