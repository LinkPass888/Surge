#!name=广汽本田App屏蔽更新
#!desc=通过修改 8081 端口下的 startFind 接口响应体，将 versionType 改为 1 以跳过更新检测。可能仅适用于3.1.2版本,未测试
#!category=Linkpass888
#!category=应用增强

[Script]
# 拦截并修改更新检测接口
ghac_no_update = type=http-response, pattern=^https?:\/\/gha\.ghac\.cn:8081\/base\/app\/api\/ad\/startFind, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/LinkPass888/Surge/refs/heads/main/js/ghac_version.js

[MITM]
hostname = %APPEND% gha.ghac.cn:8081
