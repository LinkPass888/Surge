#!name=iKuuu签到
#!desc=iKuuu机场签到及cookie获取
#!category=定时任务

[Script]
ikuuu签到 = type=cron,cronexp=12 0 * * *,wake-system=1,timeout=30,script-path=https://raw.githubusercontent.com/LinkPass888/Surge/refs/heads/main/js/ikuuu签到.js,debug=0

[MITM]
hostname = %APPEND% ikuuu.win

[Script]
IKU-COOKIE = type=http-request,pattern=^https:\/\/ikuuu\.win\/user,script-path=https://raw.githubusercontent.com/LinkPass888/Surge/refs/heads/main/js/ikuuu签到.js
