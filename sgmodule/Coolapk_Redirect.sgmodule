#!name=酷安链接直开
#!desc=在酷安(Coolapk)中点击外部链接时，跳过"未知网页安全提示"页面，直接 302 重定向到目标链接。
#!author=LinkPass888 
#!category=应用增强


[URL Rewrite]
# 仅重定向外部链接；酷安内部动态/帖子链接（coolapk.com 及其子域）放行
^https?://www\.coolapk\.com/link\?(?:.*?&)?url=((?!https?://(?:[^/]*\.)?coolapk\.com)[^&#]+).*$ $1 302

[MITM]
hostname = %APPEND% www.coolapk.com