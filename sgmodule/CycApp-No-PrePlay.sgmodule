#!name=CycApp 隐藏播放前弹窗
#!desc=移除 CycApp 播放前弹窗和选集页广告配置；不修改账号权限或广告奖励状态
#!author=Minis
#!homepage=https://github.com/LinkPass888/CycNoReward
#!icon=https://mapi.babel.gold/favicon.ico

[Script]
CycApp-pre-play = type=http-response,pattern=^https:\/\/mapi\.babel\.gold\/app\/adverts\?position=pre_play(?:&.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/LinkPass888/Surge/main/js/cycapp-preplay.js,timeout=10,argument=
CycApp-video-info = type=http-response,pattern=^https:\/\/mapi\.babel\.gold\/app\/adverts\?position=video_info(?:&.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/LinkPass888/Surge/main/js/cycapp-preplay.js,timeout=10,argument=

[URL Rewrite]
^https:\/\/my\.mujika\.pro\/(?:#\/)?register\?code=vkFpkD3a - reject-dict

[MITM]
hostname = %APPEND% mapi.babel.gold
