#!name=小浣熊 OpenAI 反代
#!desc=把商汤小浣熊包装成 OpenAI 兼容 API，账号密码自动登录；主链路 llm/v2 网关 + office/v3 自动回退，模型目录动态获取
#!author=LinkPass888
#!category=工具
#!arguments=nation:86,phone:none,password:none,token:none
#!arguments-desc=填手机号+密码自动登录，或填 token 直接使用；不用的项保持 none

[MITM]
hostname = %APPEND% xiaohuanxiong.com

[Script]
小浣熊反代 = type=http-request,pattern=^https://xiaohuanxiong\.com/v1/(chat/completions|models|probe),requires-body=true,max-size=10485760,engine=webview,timeout=600,script-path=https://raw.githubusercontent.com/LinkPass888/Surge/main/js/raccoon-openai.js,argument="nation={{{nation}}}&phone={{{phone}}}&password={{{password}}}&token={{{token}}}"
